/target

# Artefacts a build or a run leaves behind. Anchored to the repository root,
# where the name is ours alone, so a future tests/fixtures/*.ply stays
# trackable.
/*.zip
/*.exe
/*.pdb
/*.ply
/*.log
/terrapin_out/
# Where the release workflow stages terrapin.exe and its checksum. CI never
# commits, but the same two commands are the way to package a build by hand.
/dist/

# Editor and Explorer leftovers.
.vscode/
.idea/
Thumbs.db
desktop.ini
